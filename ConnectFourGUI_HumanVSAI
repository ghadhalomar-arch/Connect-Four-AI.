
import javax.swing.*;
import java.awt.*;

public class ConnectFourGUI_HumanVSAI extends JFrame {

	// Alpha-Beta AI agent
	private Alpha_Beta ai = new Alpha_Beta(6);

	// Number of rows and columns
	private final int rows = 6;
	private final int cols = 7;

	// Game board and graphical cells
	private ConnectFourGame game;
	private JPanel[][] cells = new JPanel[rows][cols];

	// MAX starts the game
	private int currentPlayer = 1;

	private JLabel title;

	// Interface colors
	private final Color backgroundColor = new Color(16, 27, 48);
	private final Color boardColor = new Color(36, 83, 164);
	private final Color maxColor = new Color(243, 206, 64);
	private final Color minColor = new Color(230, 80, 80);

	// Constructor
	public ConnectFourGUI_HumanVSAI() {

		game = new ConnectFourGame();
		game.initiallizeBoard();

		// Window settings
		setTitle("Connect Four AI");
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setSize(900, 750);
		setLocationRelativeTo(null);
		setResizable(false);

		// Main panel
		JPanel mainPanel = new JPanel();
		mainPanel.setLayout(new BorderLayout());
		mainPanel.setBackground(backgroundColor);
		setContentPane(mainPanel);

		// Game title
		title = new JLabel("CONNECT FOUR", SwingConstants.CENTER);
		title.setFont(new Font("Arial", Font.BOLD, 36));
		title.setForeground(Color.WHITE);
		title.setBorder(BorderFactory.createEmptyBorder(20, 0, 20, 0));

		// Add components to the main panel
		mainPanel.add(title, BorderLayout.NORTH);
		mainPanel.add(createBoardPanel(), BorderLayout.CENTER);
		mainPanel.add(createButtonsPanel(), BorderLayout.SOUTH);

		setVisible(true);
	}

	// Create the graphical board
	private JPanel createBoardPanel() {

		JPanel boardPanel = new JPanel();

		boardPanel.setLayout(new GridLayout(rows, cols, 8, 8));
		boardPanel.setBackground(boardColor);
		boardPanel.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));

		// Create the 42 cells
		for (int row = 0; row < rows; row++) {
			for (int col = 0; col < cols; col++) {

				cells[row][col] = new JPanel();
				cells[row][col].setBackground(backgroundColor);

				boardPanel.add(cells[row][col]);
			}
		}

		return boardPanel;
	}

	// Update the board colors
	private void updateBoard() {

		for (int row = 0; row < rows; row++) {
			for (int col = 0; col < cols; col++) {

				if (game.board[row][col] == 1) {
					cells[row][col].setBackground(maxColor);

				} else if (game.board[row][col] == 2) {
					cells[row][col].setBackground(minColor);

				} else {
					cells[row][col].setBackground(backgroundColor);
				}
			}
		}
	}

	// Create the column buttons
	private JPanel createButtonsPanel() {

		JPanel buttonsPanel = new JPanel();

		buttonsPanel.setLayout(new GridLayout(1, cols, 8, 8));
		buttonsPanel.setBackground(backgroundColor);
		buttonsPanel.setBorder(BorderFactory.createEmptyBorder(10, 15, 10, 15));

		for (int col = 0; col < cols; col++) {

			JButton button = new JButton("Column " + (col + 1));

			button.setFont(new Font("Arial", Font.BOLD, 14));
			button.setBackground(boardColor);
			button.setForeground(Color.WHITE);
			button.setPreferredSize(new Dimension(100, 40));

			final int selectedColumn = col;

			// Play a move when the button is clicked
			button.addActionListener(e -> playMove(selectedColumn));

			buttonsPanel.add(button);
		}

		return buttonsPanel;
	}

	// Check if the game has ended
	private boolean checkGameOver() {

		if (game.checkWinner(1)) {
			title.setText("MAX WINS!");
			title.setForeground(maxColor);
			return true;
		}

		if (game.checkWinner(2)) {
			title.setText("MIN WINS!");
			title.setForeground(minColor);
			return true;
		}

		if (game.isDraw()) {
			title.setText("DRAW!");
			return true;
		}

		return false;
	}

	// Play the AI's move
	private void aiMove() {

		// Find the best column using Alpha-Beta
		int bestColumn = ai.chooseMove(game, 2);

		// Check if the selected column is valid
		if (!game.isValidMove(bestColumn)) {
			title.setText("INVALID AI MOVE");
			return;
		}

		// Place the AI's token
		game.makeMove(bestColumn, 2);
		updateBoard();

		if (checkGameOver()) {
			return;
		}

		// Switch back to the human player
		currentPlayer = 1;
		title.setText("YOUR TURN");
	}

	// Play the human player's move
	private void playMove(int col) {

		// Stop if the game has ended
		if (game.checkWinner(1) || game.checkWinner(2) || game.isDraw()) {
			return;
		}

		// Check if it is the human player's turn
		if (currentPlayer != 1) {
			return;
		}

		// Check if the column is valid
		if (!game.isValidMove(col)) {
			title.setText("COLUMN IS FULL");
			return;
		}

		// Human player's move
		game.makeMove(col, currentPlayer);
		updateBoard();

		if (checkGameOver()) {
			return;
		}

		// Switch to the AI
		currentPlayer = 2;
		title.setText("AI IS THINKING...");

		// Give the interface time to display the human's move
		Timer timer = new Timer(300, e -> aiMove());
		timer.setRepeats(false);
		timer.start();
	}
}
